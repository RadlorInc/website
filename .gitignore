# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the example, which carries the variable NAMES and no values. It is the only record
# in the repo that app/api/waitlist/route.ts needs these, so it has to be committed.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# the Higgsfield master for the hero clip. public/hero*.webm|mp4|jpg are encoded FROM it
# (see handoff.md); it is 2.9 MB of source that the site never serves, so it stays local.
/hero-source.mp4
