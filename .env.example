# Copy to `.env.local` and fill in. `.env.local` is git-ignored; this file is not.
#
# THIS FILE IS THE RECORD THAT THESE VARIABLES EXIST. Without it the only trace is a
# `process.env` read inside app/api/waitlist/route.ts, which a new machine or a fresh
# deploy has no way to discover — the waitlist just silently 303s every signup to
# /waitlist/problem and logs. Add a variable here in the same commit that reads one.
#
# These belong to the radlor-site Supabase project, NOT the product's
# (qaymxunzlarwusogwyak). The service key bypasses RLS on every table in whatever
# project it belongs to, so it must never be a key to the database holding
# children's data. See docs/brand-facts.md and CLAUDE.md.
#
# ⚠️ NEVER prefix either of these with NEXT_PUBLIC_. That prefix inlines the value into
# the browser bundle, and a service_role key there hands every visitor write access to
# every table in the project.
#
# In Vercel these go in Settings → Environment Variables for BOTH Production and
# Preview. Environment variables are read at build/run time, so changing them does not
# affect an existing deployment — redeploy after adding them.

# No trailing slash — route.ts builds `${SUPABASE_URL}/rest/v1/waitlist`
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The anon/publishable key (Settings → API Keys → `anon`). NOT used by the site at runtime —
# nothing here ever hands a Supabase key to a browser. It exists ONLY so
# `npm run check:waitlist-rls` can prove the waitlist table is unreachable with it, by trying,
# rather than trusting the RLS config. Safe to hold; it is designed to sit in browsers.
# ⚠️ Still never NEXT_PUBLIC_ it — see above.
SUPABASE_ANON_KEY=

# Optional. Defaults to https://radlor.com; set it for a preview deployment.
NEXT_PUBLIC_SITE_URL=
